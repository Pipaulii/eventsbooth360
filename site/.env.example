# Configuration serveur, a renseigner dans les secrets Render en production.
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=
DATABASE_URL=
ICLOUD_SYNC_ENABLED=false
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
ICLOUD_CALENDAR_NAME=EventsBooth360

# Envoi Resend SMTP, après vérification DNS. La clé reste uniquement dans Render.
# Garder gmail tant que les redirections et le domaine Resend ne sont pas vérifiés.
MAIL_PROVIDER=gmail
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
